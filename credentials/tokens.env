# Real tokens go here as KEY=value. Fill in, commit, and push so both of us
# have it on every machine. See README.md in this folder for the ground rules
# before you add anything.
#
# Leave a value blank (KEY=) rather than deleting the line if you don't have
# that token yet — makes it obvious what's still missing.

# --- Anthropic / Claude -----------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- GitHub ------------------------------------------------------------------
# Personal access token — https://github.com/settings/tokens
# Scope it to only what's actually needed (repo, read:org, etc).
GITHUB_TOKEN=

